POSTGRES_USER=overdone
POSTGRES_PASSWORD=overdone
POSTGRES_DB=overdone
DATABASE_URL=postgresql+asyncpg://overdone:overdone@db:5432/overdone
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
# Required for evaluate. OpenAI-compatible /v1 (Ollama).
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2
# Compose API sets BOOTSTRAP=true and DATA_DIR=/app/data.
# Leave bootstrap unset for a local uvicorn process.
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
