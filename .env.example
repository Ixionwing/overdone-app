POSTGRES_USER=overdone
POSTGRES_PASSWORD=overdone
POSTGRES_DB=overdone
DATABASE_URL=postgresql+asyncpg://overdone:overdone@db:5432/overdone
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
# Optional extract model. Unset = heuristic only. Do not default this to
# http://ollama:11434/v1 on a host without Compose, or every evaluate tries it.
# OLLAMA_BASE_URL=http://ollama:11434/v1
# Compose API sets BOOTSTRAP=true and DATA_DIR=/app/data.
# Leave bootstrap unset for a local uvicorn process.
OLLAMA_MODEL=llama3.2
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
